{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Treemap \u2014 Malaysia export composition. No duplicate labels. Blue/purple/yellow sector colours.",
  "width": "container",
  "height": 400,
  "config": {
    "font": "Inter, Segoe UI, sans-serif",
    "view": {
      "stroke": null
    }
  },
  "data": {
    "url": "data/malaysia_treemap_coords.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "opacity": 0.88
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x1",
          "type": "quantitative"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              400
            ]
          },
          "axis": null
        },
        "y2": {
          "field": "y1",
          "type": "quantitative"
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "scale": {
            "domain": [
              "Manufacturing",
              "Energy & Mining",
              "Agriculture & Food"
            ],
            "range": [
              "#2166AC",
              "#8B2FC9",
              "#C8A200"
            ]
          },
          "legend": {
            "title": "Sector",
            "orient": "bottom",
            "labelFontSize": 13,
            "titleFontSize": 12,
            "symbolSize": 160
          }
        },
        "tooltip": [
          {
            "field": "sub_sector",
            "type": "nominal",
            "title": "Product"
          },
          {
            "field": "sector",
            "type": "nominal",
            "title": "Sector"
          },
          {
            "field": "value_rm_mil",
            "type": "quantitative",
            "format": ",.1f",
            "title": "Value (RM mil)"
          },
          {
            "field": "share_total_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Share of exports (%)"
          },
          {
            "field": "share_in_sector_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Share within sector (%)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.w >= 55 && datum.h >= 22 && (datum.w < 130 || datum.h < 35)"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "align": "center",
        "fontSize": 11,
        "fontWeight": "normal",
        "color": "#ffffff",
        "opacity": 1,
        "limit": 110,
        "dy": -7
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              400
            ]
          },
          "axis": null
        },
        "text": {
          "field": "short_name",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.w >= 55 && datum.h >= 22 && (datum.w < 130 || datum.h < 35)"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "align": "center",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#ffffff",
        "opacity": 0.9,
        "dy": 7
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              400
            ]
          },
          "axis": null
        },
        "text": {
          "field": "share_total_pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.w >= 130 && datum.h >= 35"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "align": "center",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#ffffff",
        "opacity": 1,
        "limit": 180,
        "dy": -10
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              400
            ]
          },
          "axis": null
        },
        "text": {
          "field": "short_name",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.w >= 130 && datum.h >= 35"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "align": "center",
        "fontSize": 13,
        "fontWeight": "normal",
        "color": "#ffffff",
        "opacity": 0.9,
        "dy": 10
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              400
            ]
          },
          "axis": null
        },
        "text": {
          "field": "share_total_pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}