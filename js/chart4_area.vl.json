{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Malaysia exports vs imports 1990-2023. Surplus gap shaded. Crisis events annotated.",
  "width": "container",
  "height": 340,
  "config": {
    "font": "Inter, Segoe UI, sans-serif",
    "view": { "stroke": null }
  },
  "data": { "url": "data/malaysia_trade_timeseries.csv" },
  "layer": [
    {
      "mark": { "type": "area", "opacity": 0.20, "line": false },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "axis": {
            "title": null,
            "tickCount": 7,
            "format": "d",
            "labelAngle": 0,
            "labelFlush": true,
            "labelFontSize": 12
          }
        },
        "y": {
          "field": "value_usd_bn",
          "type": "quantitative",
          "axis": {
            "title": "Trade value (USD billions)",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "grid": true,
            "gridColor": "#f0ede8"
          }
        },
        "color": {
          "field": "metric", "type": "nominal",
          "scale": {
            "domain": ["Exports", "Imports"],
            "range": ["#FB3640", "#000F08"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": { "type": "line", "strokeWidth": 2.5 },
      "encoding": {
        "x": {
          "field": "year", "type": "quantitative",
          "axis": { "tickCount": 7, "format": "d", "labelAngle": 0, "labelFontSize": 12 }
        },
        "y": { "field": "value_usd_bn", "type": "quantitative" },
        "color": {
          "field": "metric", "type": "nominal",
          "scale": {
            "domain": ["Exports", "Imports"],
            "range": ["#FB3640", "#000F08"]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "year",         "type": "quantitative", "format": "d",   "title": "Year" },
          { "field": "metric",       "type": "nominal",                        "title": "Metric" },
          { "field": "value_usd_bn", "type": "quantitative", "format": ".2f", "title": "USD billions" }
        ]
      }
    },
    {
      "data": {
        "values": [
          { "year": 1997 },
          { "year": 2008 },
          { "year": 2020 }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [4, 3],
        "strokeWidth": 1.2,
        "color": "#BA7517",
        "opacity": 0.7
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" }
      }
    },
    {
      "data": { "values": [{ "year": 1997 }] },
      "mark": {
        "type": "text",
        "text": "Asian Financial Crisis",
        "align": "left",
        "dx": 5,
        "y": 30,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#BA7517"
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" }
      }
    },
    {
      "data": { "values": [{ "year": 2008 }] },
      "mark": {
        "type": "text",
        "text": "Global Financial Crisis",
        "align": "left",
        "dx": 5,
        "y": 15,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#BA7517"
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" }
      }
    },
    {
      "data": { "values": [{ "year": 2020 }] },
      "mark": {
        "type": "text",
        "text": "COVID-19",
        "align": "right",
        "dx": -5,
        "y": 15,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#BA7517"
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" }
      }
    }
  ]
}