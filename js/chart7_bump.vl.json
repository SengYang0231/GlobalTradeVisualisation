{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Malaysia top trading partners by export value \u2014 ranked bar chart with year slider.",
  "width": "container",
  "height": 360,
  "config": {
    "font": "Inter, Segoe UI, sans-serif",
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "year_select",
      "value": 2023
    }
  ],
  "data": {
    "url": "data/malaysia_partner_ranks.csv"
  },
  "transform": [
    {
      "filter": "datum.year == year_select"
    },
    {
      "filter": "datum.rank <= 8"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "partner",
          "type": "nominal",
          "sort": {
            "field": "exports_usd_bn",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelFontSize": 13,
            "labelLimit": 200
          }
        },
        "x": {
          "field": "exports_usd_bn",
          "type": "quantitative",
          "axis": {
            "title": "Exports to partner (USD billions)",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "grid": true,
            "gridColor": "#f0ede8"
          }
        },
        "color": {
          "condition": [
            {
              "test": "datum.rank == 1",
              "value": "#FB3640"
            },
            {
              "test": "datum.rank == 2",
              "value": "#D4737A"
            },
            {
              "test": "datum.rank == 3",
              "value": "#C4A0A2"
            }
          ],
          "value": "#B4B2A9"
        },
        "tooltip": [
          {
            "field": "partner",
            "type": "nominal",
            "title": "Partner"
          },
          {
            "field": "year",
            "type": "quantitative",
            "format": "d",
            "title": "Year"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank"
          },
          {
            "field": "exports_usd_bn",
            "type": "quantitative",
            "format": ".2f",
            "title": "Exports (USD bn)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12,
        "fontWeight": "600",
        "color": "#ffffff"
      },
      "encoding": {
        "y": {
          "field": "partner",
          "type": "nominal",
          "sort": {
            "field": "exports_usd_bn",
            "order": "descending"
          }
        },
        "x": {
          "datum": 0
        },
        "text": {
          "field": "rank",
          "type": "quantitative",
          "format": "d"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12,
        "color": "#5A5248"
      },
      "encoding": {
        "y": {
          "field": "partner",
          "type": "nominal",
          "sort": {
            "field": "exports_usd_bn",
            "order": "descending"
          }
        },
        "x": {
          "field": "exports_usd_bn",
          "type": "quantitative"
        },
        "text": {
          "field": "exports_usd_bn",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}