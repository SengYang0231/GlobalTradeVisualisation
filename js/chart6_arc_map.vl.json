{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Arc flow map — Malaysia trade flows to top partners. Pure Vega-Lite geographic projection.",
  "width": "container",
  "height": 460,
  "config": {
    "font": "Inter, Segoe UI, sans-serif",
    "view": { "stroke": null }
  },
  "projection": { "type": "equalEarth" },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@1.31.1/data/world-110m.json",
        "format": { "type": "topojson", "feature": "countries" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e3db",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/malaysia_arcs.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeOpacity": 0.75
      },
      "encoding": {
        "stroke": {
          "field": "properties.trade_type",
          "type": "nominal",
          "scale": {
            "domain": ["Export-heavy", "Import-heavy"],
            "range": ["#1D9E75", "#D85A30"]
          },
          "legend": {
            "title": "Trade type",
            "orient": "bottom-left",
            "labelFontSize": 11
          }
        },
        "strokeWidth": {
          "field": "properties.stroke_width",
          "type": "quantitative",
          "legend": null
        },
        "tooltip": [
          { "field": "properties.partner",        "type": "nominal",      "title": "Partner" },
          { "field": "properties.exports_usd_bn", "type": "quantitative", "format": ".2f", "title": "Exports (USD bn)" },
          { "field": "properties.imports_usd_bn", "type": "quantitative", "format": ".2f", "title": "Imports (USD bn)" },
          { "field": "properties.balance_usd_bn", "type": "quantitative", "format": ".2f", "title": "Balance (USD bn)" }
        ]
      }
    },
    {
      "data": { "url": "data/malaysia_arc_map.csv" },
      "mark": {
        "type": "circle",
        "size": 55,
        "color": "#534AB7",
        "opacity": 0.85,
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": { "field": "dest_lon", "type": "quantitative" },
        "latitude":  { "field": "dest_lat", "type": "quantitative" },
        "tooltip": [
          { "field": "partner",        "type": "nominal",      "title": "Partner" },
          { "field": "exports_usd_bn", "type": "quantitative", "format": ".2f", "title": "Exports (USD bn)" }
        ]
      }
    },
    {
      "data": { "values": [{ "lon": 109.45, "lat": 4.21, "label": "Malaysia" }] },
      "mark": {
        "type": "circle",
        "size": 100,
        "color": "#534AB7",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude":  { "field": "lat", "type": "quantitative" }
      }
    },
    {
      "data": { "values": [{ "lon": 109.45, "lat": 4.21, "label": "Malaysia" }] },
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#534AB7"
      },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude":  { "field": "lat", "type": "quantitative" },
        "text":      { "field": "label", "type": "nominal" }
      }
    }
  ]
}
