{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Malaysia exports by SITC section 2000-2023. Stacked area chart. Colours match chart 10.",
  "width": "container",
  "height": 360,
  "config": {
    "font": "Inter, Segoe UI, sans-serif",
    "view": { "stroke": null }
  },
  "data": { "url": "data/malaysia_exports_by_sitc_annual.csv" },
  "mark": { "type": "area", "opacity": 0.88 },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelExpr": "datum.value % 5 === 0 ? datum.label : ''"
      }
    },
    "y": {
      "field": "exports_rm_bil",
      "type": "quantitative",
      "stack": "zero",
      "axis": {
        "title": "Exports (RM billions)",
        "titleFontSize": 13,
        "labelFontSize": 12,
        "grid": true,
        "gridColor": "#f0ede8"
      }
    },
    "color": {
      "field": "section_label",
      "type": "nominal",
      "scale": {
        "domain": [
          "Machinery & Transport Equipment",
          "Mineral Fuels & Petroleum",
          "Misc. Manufactured Articles",
          "Manufactured Goods",
          "Chemicals",
          "Animal & Vegetable Oils",
          "Food & Live Animals",
          "Crude Materials",
          "Other Commodities",
          "Beverages & Tobacco"
        ],
        "range": [
          "#0072B2",
          "#E69F00",
          "#56B4E9",
          "#CC79A7",
          "#A65628",
          "#4DAF4A",
          "#377EB8",
          "#984EA3",
          "#FF7F00",
          "#666666"
        ]
      },
      "legend": {
        "title": "Export category",
        "titleFontSize": 12,
        "orient": "right",
        "labelFontSize": 12,
        "labelLimit": 220,
        "symbolSize": 150
      }
    },
    "tooltip": [
      { "field": "year",           "type": "ordinal",      "title": "Year" },
      { "field": "section_label",  "type": "nominal",      "title": "Category" },
      { "field": "exports_rm_bil", "type": "quantitative", "format": ".1f", "title": "Exports (RM bn)" }
    ]
  }
}