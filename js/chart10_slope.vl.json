{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Malaysia export category share 2000-2023. Annual data. Dual-handle year slider + category multi-select.",
  "width": "container",
  "height": 440,
  "config": { "font": "Inter, Segoe UI, sans-serif", "view": { "stroke": null } },
  "params": [
    {
      "name": "selected_cats",
      "value": [
        "Mineral Fuels & Petroleum", "Misc. Manufactured Articles",
        "Manufactured Goods", "Chemicals",
        "Animal & Vegetable Oils", "Food & Live Animals"
      ]
    },
    { "name": "year_min", "value": 2000 },
    { "name": "year_max", "value": 2023 }
  ],
  "data": { "url": "data/malaysia_export_mix_slope.csv" },
  "layer": [
    {
      "transform": [
        { "filter": "+datum.snapshot_year >= year_min && +datum.snapshot_year <= year_max" }
      ],
      "mark": { "type": "line", "strokeWidth": 2.0, "interpolate": "linear" },
      "encoding": {
        "x": {
          "field": "snapshot_year", "type": "quantitative",
          "scale": { "zero": false },
          "axis": {
            "title": null,
            "labelFontSize": 11,
            "format": "d",
            "tickMinStep": 1,
            "tickCount": 24
          }
        },
        "y": {
          "field": "share_pct", "type": "quantitative",
          "axis": {
            "title": "Share of total exports (%)",
            "titleFontSize": 13, "labelFontSize": 12,
            "grid": true, "gridColor": "#f0ede8"
          }
        },
        "color": {
          "field": "section_label", "type": "nominal",
          "scale": {
            "domain": [
              "Machinery & Transport Equipment", "Mineral Fuels & Petroleum",
              "Misc. Manufactured Articles", "Manufactured Goods", "Chemicals",
              "Animal & Vegetable Oils", "Food & Live Animals",
              "Crude Materials", "Other Commodities", "Beverages & Tobacco"
            ],
            "range": [
              "#0072B2","#E69F00","#56B4E9","#CC79A7","#A65628",
              "#4DAF4A","#377EB8","#984EA3","#FF7F00","#666666"
            ]
          },
          "legend": null
        },
        "detail": { "field": "section_label", "type": "nominal" },
        "strokeOpacity": {
          "condition": { "test": "indexof(selected_cats, datum.section_label) >= 0", "value": 0.88 },
          "value": 0.05
        }
      }
    },
    {
      "transform": [
        { "filter": "+datum.snapshot_year >= year_min && +datum.snapshot_year <= year_max" }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 40,
        "strokeWidth": 0.8,
        "stroke": "#ffffff"
      },
      "encoding": {
        "x": { "field": "snapshot_year", "type": "quantitative", "scale": { "zero": false } },
        "y": { "field": "share_pct", "type": "quantitative" },
        "color": {
          "field": "section_label", "type": "nominal",
          "scale": {
            "domain": [
              "Machinery & Transport Equipment", "Mineral Fuels & Petroleum",
              "Misc. Manufactured Articles", "Manufactured Goods", "Chemicals",
              "Animal & Vegetable Oils", "Food & Live Animals",
              "Crude Materials", "Other Commodities", "Beverages & Tobacco"
            ],
            "range": [
              "#0072B2","#E69F00","#56B4E9","#CC79A7","#A65628",
              "#4DAF4A","#377EB8","#984EA3","#FF7F00","#666666"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": { "test": "indexof(selected_cats, datum.section_label) >= 0", "value": 1 },
          "value": 0.05
        },
        "tooltip": [
          { "field": "section_label", "type": "nominal",      "title": "Category" },
          { "field": "snapshot_year", "type": "quantitative", "format": "d", "title": "Year" },
          { "field": "share_pct",     "type": "quantitative", "format": ".1f", "title": "Share (%)" }
        ]
      }
    }
  ]
}