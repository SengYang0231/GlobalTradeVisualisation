{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Trade as % of GDP \u2014 top open economies vs Malaysia. Malaysia ranks last but still exceeds global average.",
  "width": "container",
  "height": 320,
  "config": {
    "font": "Inter, Segoe UI, sans-serif",
    "view": {
      "stroke": null
    }
  },
  "data": {
    "url": "data/top10_exporters.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": null,
          "axis": {
            "title": null,
            "labelFontSize": 13,
            "labelLimit": 180
          }
        },
        "x": {
          "field": "trade_pct_gdp",
          "type": "quantitative",
          "axis": {
            "title": "Trade as % of GDP",
            "titleFontSize": 13,
            "grid": true,
            "tickCount": 5,
            "labelFontSize": 12,
            "gridColor": "#f0ede8"
          }
        },
        "color": {
          "condition": {
            "test": "datum.highlight == 'True'",
            "value": "#EF9F27"
          },
          "value": "#B4B2A9"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "trade_pct_gdp",
            "type": "quantitative",
            "format": ".1f",
            "title": "Trade % of GDP"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.highlight == 'True'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#EF9F27"
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": null
        },
        "x": {
          "field": "trade_pct_gdp",
          "type": "quantitative"
        },
        "text": {
          "value": "\u2190 Malaysia"
        }
      }
    }
  ]
}