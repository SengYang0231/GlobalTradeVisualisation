{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Malaysia trade balance 1990-2023. Year on X, balance on Y. Surplus=teal, Deficit=coral.",
  "width": "container",
  "height": 280,
  "config": {
    "font": "Inter, Segoe UI, sans-serif",
    "view": { "stroke": null }
  },
  "data": { "url": "data/malaysia_trade_balance.csv" },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "color": "#CCCCCC",
        "strokeDash": [2, 2]
      },
      "encoding": { "y": { "datum": 0 } }
    },
    {
      "mark": { "type": "rule", "strokeWidth": 3 },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": { "domain": [1990, 2023] },
          "axis": {
            "title": null,
            "tickCount": 7,
            "format": "d",
            "labelAngle": 0,
            "labelFlush": true
          }
        },
        "y": {
          "field": "balance_usd_bn",
          "type": "quantitative",
          "axis": {
            "title": "Trade balance (USD bn)",
            "titleFontSize": 11,
            "grid": true,
            "gridColor": "#f0ede8"
          }
        },
        "y2": { "datum": 0 },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": ["Surplus", "Deficit"],
            "range": ["#1D9E75", "#D85A30"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 55,
        "strokeWidth": 0
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" },
        "y": { "field": "balance_usd_bn", "type": "quantitative" },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": ["Surplus", "Deficit"],
            "range": ["#1D9E75", "#D85A30"]
          },
          "legend": {
            "title": null,
            "orient": "top-left",
            "labelFontSize": 11
          }
        },
        "tooltip": [
          { "field": "year", "type": "quantitative",
            "format": "d", "title": "Year" },
          { "field": "balance_usd_bn", "type": "quantitative",
            "format": ".2f", "title": "Balance (USD bn)" },
          { "field": "direction", "type": "nominal", "title": "Status" }
        ]
      }
    },
    {
      "data": {
        "values": [
          { "year": 1997, "label": "1997 Crisis" },
          { "year": 2008, "label": "2008 GFC" },
          { "year": 2020, "label": "COVID-19" }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [4, 3],
        "strokeWidth": 1.2,
        "color": "#BA7517",
        "opacity": 0.7
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" }
      }
    },
    {
      "data": {
        "values": [
          { "year": 1997, "label": "1997 Crisis" },
          { "year": 2008, "label": "2008 GFC" },
          { "year": 2020, "label": "COVID-19" }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#BA7517",
        "y": 8
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" },
        "text": { "field": "label" }
      }
    }
  ]
}