{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Malaysia bilateral trade balance. Surplus = red, Deficit = dark. Sorted by region then balance.",
  "width": "container",
  "height": {
    "step": 28
  },
  "config": {
    "font": "Inter, Segoe UI, sans-serif",
    "view": {
      "stroke": null
    }
  },
  "data": {
    "url": "data/malaysia_partner_balance.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "color": "#918980",
        "strokeDash": [
          3,
          2
        ]
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5
      },
      "encoding": {
        "y": {
          "field": "short_label",
          "type": "nominal",
          "sort": {
            "field": "sort_order",
            "order": "ascending"
          },
          "axis": {
            "title": null,
            "labelFontSize": 13,
            "labelLimit": 230
          }
        },
        "x": {
          "field": "balance_usd_bn",
          "type": "quantitative",
          "axis": {
            "title": "Bilateral trade balance (USD billions)",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "grid": true,
            "gridColor": "#f0ede8"
          }
        },
        "x2": {
          "datum": 0,
          "type": "quantitative"
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surplus",
              "Deficit"
            ],
            "range": [
              "#FB3640",
              "#000F08"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100,
        "strokeWidth": 0
      },
      "encoding": {
        "y": {
          "field": "short_label",
          "type": "nominal",
          "sort": {
            "field": "sort_order",
            "order": "ascending"
          }
        },
        "x": {
          "field": "balance_usd_bn",
          "type": "quantitative"
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surplus",
              "Deficit"
            ],
            "range": [
              "#FB3640",
              "#000F08"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom-right",
            "labelFontSize": 13,
            "symbolSize": 150
          }
        },
        "tooltip": [
          {
            "field": "partner",
            "type": "nominal",
            "title": "Partner"
          },
          {
            "field": "region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "exports_usd_bn",
            "type": "quantitative",
            "format": ".2f",
            "title": "Exports (USD bn)"
          },
          {
            "field": "imports_usd_bn",
            "type": "quantitative",
            "format": ".2f",
            "title": "Imports (USD bn)"
          },
          {
            "field": "balance_usd_bn",
            "type": "quantitative",
            "format": ".2f",
            "title": "Balance (USD bn)"
          }
        ]
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.partner === 'Middle East, North Africa, Afghanistan & Pakistan' ? 'Middle East & N. Africa' : datum.partner",
      "as": "short_label"
    }
  ]
}