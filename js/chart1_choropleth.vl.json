{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "World choropleth — merchandise exports as % of GDP. Malaysia highlighted in amber.",
  "width": "container",
  "height": 420,
  "config": { "font": "Inter, Segoe UI, sans-serif", "view": { "stroke": null } },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@1.31.1/data/world-110m.json",
        "format": { "type": "topojson", "feature": "countries" }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": { "url": "data/iso_numeric.csv" },
            "key": "numeric",
            "fields": ["alpha3"]
          }
        },
        {
          "lookup": "alpha3",
          "from": {
            "data": { "url": "data/choropleth_exports.csv" },
            "key": "code",
            "fields": ["exports_pct_gdp", "country"]
          }
        }
      ],
      "projection": { "type": "naturalEarth1" },
      "mark": { "type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.4 },
      "encoding": {
        "color": {
          "condition": [
            {
              "test": "datum.alpha3 === 'MYS'",
              "value": "#EF9F27"
            },
            {
              "test": "!isValid(datum.exports_pct_gdp)",
              "value": "#D3D1C7"
            }
          ],
          "field": "exports_pct_gdp",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [0, 100],
            "clamp": true
          },
          "legend": {
            "title": "Exports % of GDP",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 200,
            "titleFontSize": 13,
            "labelFontSize": 12,
            "offset": 10
          }
        },
        "tooltip": [
          { "field": "country",         "type": "nominal",      "title": "Country" },
          { "field": "exports_pct_gdp", "type": "quantitative", "format": ".1f", "title": "Exports % GDP" }
        ]
      }
    },
    {
      "data": { "values": [{ "lon": 109.45, "lat": 4.21 }] },
      "projection": { "type": "naturalEarth1" },
      "mark": {
        "type": "point",
        "size": 90,
        "filled": true,
        "color": "#EF9F27",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude":  { "field": "lat", "type": "quantitative" }
      }
    },
    {
      "data": { "values": [{ "lon": 109.45, "lat": 4.21 }] },
      "projection": { "type": "naturalEarth1" },
      "mark": {
        "type": "text",
        "text": "Malaysia",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#EF9F27",
        "dy": -14,
        "dx": 4
      },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude":  { "field": "lat", "type": "quantitative" }
      }
    }
  ]
}